{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "交互式 CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "审查示例文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--review", "samples/buggy_calculator.py"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "运行离线测试",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_agent_loop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
